# ==========================================
# Campus Placement Accelerator - Environment Configuration
# ==========================================

# Server Port (default: 3000)
PORT=3000

# Node Environment: 'production' or 'development'
# In production, secure JWT secret and SSL are enforced.
NODE_ENV=production

# PostgreSQL Connection String (Required for production relational database)
# Examples:
# Supabase: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
# Render / Railway: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgresql://placement_user:secure_password_here@localhost:5432/placement_tracker?sslmode=require

# Database SSL configuration
# Set to 'true' to enforce TLS/SSL connection with managed PostgreSQL providers (Supabase, Neon, AWS RDS, Render, etc.)
DATABASE_SSL=true

# Connection Pool Size (default: 10)
DB_POOL_MAX=10

# JWT Signing Secret (CRITICAL: In production, must be a cryptographically random string of 32+ characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-strong-random-secret-of-at-least-32-chars

# CORS Allowed Origins
# Comma-separated list of origins allowed to make browser requests.
# Set this to your production Flutter web app URL (e.g., https://campus-accelerator.web.app)
CORS_ORIGIN=https://your-production-web-app.example.com,http://localhost:8080
